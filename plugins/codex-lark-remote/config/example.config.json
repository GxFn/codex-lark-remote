{
  "lark": {
    "appId": "cli_xxx",
    "appSecret": "xxx",
    "verificationToken": "",
    "encryptKey": "",
    "allowedUsers": [],
    "transport": "websocket",
    "websocket": true,
    "websocketStartTimeoutMs": 10000
  },
  "defaultRepo": "example",
  "repos": {
    "example": {
      "path": "/absolute/path/to/your/repo",
      "remote": "origin",
      "baseBranch": "main",
      "testCommand": "npm test"
    }
  },
  "runner": {
    "sandbox": "workspace-write",
    "askForApproval": "never",
    "ignoreUserConfig": true,
    "model": ""
  },
  "handoff": {
    "enabled": true,
    "mode": "resume",
    "promptStyle": "direct",
    "notifyQueued": false,
    "notifyStarted": false
  },
  "takeover": {
    "enabled": true,
    "projectLimit": 20,
    "selectionTtlMs": 600000,
    "maxPendingInputs": 20
  },
  "startup": {
    "enabled": true,
    "once": true,
    "rememberLastChat": true,
    "receiveId": "",
    "receiveIdType": "chat_id"
  },
  "intent": {
    "enabled": true,
    "mode": "hybrid",
    "consoleChatIds": [],
    "translator": {
      "provider": "codex-thread",
      "timeoutMs": 15000,
      "minConfidence": 0.75
    },
    "fallbackToHandoff": true
  },
  "policy": {
    "requireReviewForCommit": true,
    "requireReviewForPush": true,
    "maxPromptChars": 4000,
    "maxResultChars": 3000,
    "allowNetwork": false
  }
}
